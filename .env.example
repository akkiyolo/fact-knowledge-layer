# ============================================================
# Fact Knowledge Layer — Environment Configuration (Example)
# ============================================================
# Copy this file to .env and fill in your values.

# --- Application ---
APP_NAME=Fact Knowledge Layer
APP_ENV=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

# --- Database (Render PostgreSQL) ---
# IMPORTANT: Use your Render PostgreSQL EXTERNAL DATABASE URL
DATABASE_URL=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST:5432/YOUR_DATABASE

# --- LLM (Ollama) ---
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# --- Embeddings (Local Sentence Transformers) ---
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384

# --- Claim Extraction ---
CLAIM_CONFIDENCE_THRESHOLD=0.70
GROUNDING_CONFIDENCE_THRESHOLD=0.70
MAX_CLAIMS_PER_CHUNK=30

# --- Vector Retrieval ---
CANDIDATE_TOP_K=10
CANDIDATE_SIMILARITY_THRESHOLD=0.70

# --- Attribute Canonicalization ---
ATTRIBUTE_SIMILARITY_THRESHOLD=0.85

# --- PDF Chunking ---
MAX_CHUNK_TOKENS=1200
CHUNK_OVERLAP_TOKENS=150

# --- File Storage ---
UPLOAD_DIR=data/uploads
SAMPLE_DIR=data/sample
MAX_UPLOAD_SIZE_MB=50
